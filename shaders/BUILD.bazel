load("@rules_zig//zig:defs.bzl", "zig_library")

genrule(
    name = "gemm_nvcoop2_f16_spv",
    srcs = ["gemm_nvcoop2_f16.slang"],
    outs = ["gemm_nvcoop2_f16.spv"],
    cmd = """
set -euo pipefail
$(execpath @slang//:bin/slangc) $(location gemm_nvcoop2_f16.slang) \
    -DN_TILES=2 \
    -DK_UNROLL=4 \
    -target spirv \
    -entry main \
    -stage compute \
    -capability cooperative_matrix_tensor_addressing+tensor_addressing+cooperative_matrix_2 \
    -O3 \
    -o "$@"
$(execpath @spirv_tools//:spirv-val) --target-env vulkan1.4 "$@"
""",
    tools = [
        "@slang//:bin/slangc",
        "@slang//:slang_runtime",
        "@spirv_tools//:spirv-val",
    ],
    visibility = ["//visibility:public"],
)

