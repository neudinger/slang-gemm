genrule(
    name = "gemm_nvcoop2_bf16_spv_gen",
    srcs = ["//tools:emit_nvcoop2_spv.zig"],
    outs = [
        "gemm_nvcoop2_bf16.spv",
        "gemm_nvcoop2_bf16_spv.zig",
    ],
    cmd = """
set -euo pipefail
cache="$(@D)/zig-cache"
$(ZIG_BIN) run $(location //tools:emit_nvcoop2_spv.zig) \
    --cache-dir "$$cache" \
    --global-cache-dir "$$cache" \
    -- --mode=bf16-wide "$(@D)/gemm_nvcoop2_bf16.spv" "$(@D)/gemm_nvcoop2_bf16_spv.zig"
if $(execpath @spirv_tools//:spirv-val) --target-env vulkan1.4 "$(@D)/gemm_nvcoop2_bf16.spv"; then
    :
else
    echo "warning: spirv-val does not yet accept the generated BF16 coop2 module for this toolchain" >&2
fi
""",
    tools = ["@spirv_tools//:spirv-val"],
    toolchains = ["@rules_zig//zig:resolved_toolchain"],
    visibility = ["//visibility:public"],
)

